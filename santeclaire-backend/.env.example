# =============================================================================
# SantéClaire Backend - Variables d'environnement
# =============================================================================
# Copier ce fichier vers .env.local et personnaliser les valeurs
# Ne JAMAIS commiter .env.local dans Git
# =============================================================================

###> symfony/framework-bundle ###
# Environnement: dev, test, ou prod
APP_ENV=dev

# Clé secrète pour le chiffrement (générer une clé unique en production!)
# Utiliser: php -r "echo bin2hex(random_bytes(16));"
APP_SECRET=change_this_to_a_random_32_char_string
###< symfony/framework-bundle ###

###> doctrine/doctrine-bundle ###
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?serverVersion=VERSION
DATABASE_URL="postgresql://santeclaire:secret@postgres:5432/santeclaire?serverVersion=15&charset=utf8"
###< doctrine/doctrine-bundle ###

###> lexik/jwt-authentication-bundle ###
# Chemins vers les clés JWT (générées avec: php bin/console lexik:jwt:generate-keypair)
JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem

# Passphrase pour la clé privée JWT
JWT_PASSPHRASE=your_jwt_passphrase_here
###< lexik/jwt-authentication-bundle ###

###> nelmio/cors-bundle ###
# Origines autorisées pour CORS (regex)
# En production, restreindre à votre domaine frontend
CORS_ALLOW_ORIGIN='^https?://(localhost|127\.0\.0\.1)(:[0-9]+)?$'
###< nelmio/cors-bundle ###

###> redis ###
# URL de connexion Redis pour le cache et les sessions
REDIS_URL=redis://redis:6379
###< redis ###
