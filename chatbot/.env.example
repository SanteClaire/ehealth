# Configuration de base
NODE_ENV=development
PORT=3001

# Base de données MongoDB
MONGODB_URI=mongodb://localhost:27017/santeclaire-chatbot
# Pour MongoDB Atlas, utilisez :
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/santeclaire-chatbot

# Configuration LM Studio (Local AI)
LM_STUDIO_URL=http://localhost:1234/v1
LM_STUDIO_MODEL=local-model
LM_STUDIO_MAX_TOKENS=1000
LM_STUDIO_TEMPERATURE=0.3

# Configuration Whisper Local
WHISPER_PATH=whisper
WHISPER_MODEL=base
WHISPER_LANGUAGE=fr

# Clés API IA (optionnelles - pour fallback uniquement)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Configuration des logs
LOG_LEVEL=info

# Limites et sécurité
MAX_FILE_SIZE=5242880
CACHE_EXPIRY_DAYS=7

# Budget et coûts (principalement pour le monitoring)
MAX_DAILY_COST=0.00
